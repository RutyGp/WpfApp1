<Window x:Class="WpfApp1.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:WpfApp1"
        mc:Ignorable="d"
        Title="מנהל המשימות שלי" Height="450" Width="600"
        FlowDirection="RightToLeft">

    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="2*"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <StackPanel Grid.Row="0" Orientation="Vertical" Margin="0,0,0,15">
            <Image Source="/Pictures/CLOCK.jpg" Width="150" Height="150" HorizontalAlignment="Center" Margin="0,0,0,5" />
            <TextBlock Text="מנהל המשימות שלי" FontSize="20" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,0,0,10"/>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                <Button Content="משימות פעילות" Width="120" Margin="5" Padding="5"/>
                <Button Content="משימות שהסתיימו" Width="120" Margin="5" Padding="5"/>
            </StackPanel>
        </StackPanel>
        <StackPanel Orientation="Horizontal" Grid.Row="1">
          
            <Border  Background="#F9F9F9" CornerRadius="5" BorderBrush="#E0E0E0" BorderThickness="1" Padding="10" Margin="0,0,0,15">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <!--<StackPanel x:Name="TasksContainer" Orientation="Vertical">-->
                <StackPanel Margin="20" FlowDirection="RightToLeft" x:Name="TasksContainer" Orientation="Vertical">
                    <TextBlock Text="רשימת משימות:" FontSize="16" FontWeight="Bold" Margin="0,0,0,10" />



                    <ListView x:Name="MyTasksListView" Height="200" >
                        <ListView.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal" Margin="5">

                                    <TextBlock Text="{Binding Name}" FontWeight="Bold" Foreground="DarkBlue" Width="150" VerticalAlignment="Center" />

                                    <TextBlock Text="{Binding Urgency}" Foreground="Gray" Width="100" VerticalAlignment="Center" />

                                    <TextBlock Text="{Binding DueDate, StringFormat={}{0:dd/MM/yyyy}}" Width="80" VerticalAlignment="Center" />

                                    <CheckBox IsChecked="{Binding IsCompleted}" Width="80" VerticalAlignment="Center" />

                                </StackPanel>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                </StackPanel>

            </ScrollViewer>

        </Border>



           
        </StackPanel>
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,5,0,5">
                <TextBlock Text="משימה חדשה:" VerticalAlignment="Center" FontSize="14" Margin="0,0,10,0"/>
                <TextBox x:Name="newTaskTextBox"
                         Width="200" Height="25" 
                         VerticalContentAlignment="Center"
                         Margin="0,0,10,0"
                         TextChanged="ShowCalander"/>

                <ComboBox x:Name="UrgencyComboBox" Width="90" Height="25" SelectedIndex="1" Margin="0,0,10,0">
                    <!--<ComboBoxItem Content="נמוכה"/>
                    <ComboBoxItem Content="בינונית"/>
                    <ComboBoxItem Content="גבוהה"/>-->
                </ComboBox>
               
            <Button Content="הוסף" Width="70" Height="25" Padding="5,0,5,0" Click="AddButton_Click"/>
            <!--#region Calendar-->
            <Calendar  x:Name="taskCalander" Visibility="Collapsed"  SelectedDatesChanged="DateWasChoosed"/>
            <!--#endregion-->
        </StackPanel>
        <Border   Grid.Column="1" Grid.RowSpan="2" Grid.Row="1">
            <StackPanel x:Name="contactsSp">
                <ListView x:Name="contactsLV" Background="Crimson">
                    <ListView.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal" Margin="5">

                                <TextBlock Text="{Binding Name}" FontWeight="Bold" Foreground="DarkBlue" Width="150" VerticalAlignment="Center" />

                                <TextBlock Text="{Binding City}" Foreground="Gray" Width="100" VerticalAlignment="Center" />

                                <TextBlock Text="{Binding BornDate, StringFormat={}{0:dd/MM/yyyy}}" Foreground="Gray" Width="100" VerticalAlignment="Center" />

                                <TextBlock Text="{Binding IsFavorite}" Foreground="Gray" Width="100" VerticalAlignment="Center" />

                            </StackPanel>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>

            </StackPanel>

        </Border>
    </Grid>
    </Window>


