<Window x:Class="WpfApp1.UserControlWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"

        xmlns:local="clr-namespace:WpfApp1.User_Controls"
        mc:Ignorable="d"
        FlowDirection="RightToLeft"
        Title="UserControlWindow" Height="450" Width="800">
    <Grid Margin="10">
        <ListView x:Name="ContactsListView">
           <ListView.ItemTemplate>
                <DataTemplate>
                    <local:ContactCardControl Width="350" 
                                           ContactDeleted="ContactCard_ContactDeleted" 
                                           ContactDetailsRequested="ContactCard_ContactDetailsRequested" />
                </DataTemplate>
            </ListView.ItemTemplate> 
        </ListView>
    </Grid>
</Window>


